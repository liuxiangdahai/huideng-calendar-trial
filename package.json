{
  "name": "huideng-calendar-reminders",
  "private": true,
  "scripts": {
    "dev:calendar": "node tools/calendar/serve.mjs",
    "build:calendar": "node tools/calendar/build.mjs",
    "build": "node tools/calendar/release-build.mjs",
    "build:local": "node tools/calendar/release-build.mjs --mode local",
    "test": "node --test tests/calendar/*.test.mjs tests/service/*.test.mjs tests/build/*.test.mjs",
    "test:service": "node --test tests/service/*.test.mjs",
    "build:standalone": "node tools/calendar/standalone.mjs",
    "test:browser": "node tools/calendar/test-browser.mjs",
    "test:browser:all": "node tools/calendar/test-browser.mjs --all",
    "test:build": "node --test tests/build/*.test.mjs",
    "smoke:local": "node tools/calendar/smoke-service.mjs",
    "smoke:remote": "node tools/calendar/smoke-remote.mjs",
    "verify:release": "node tools/calendar/verify-release.mjs",
    "check:calendar": "npm run build:calendar && npm test"
  },
  "engines": {"node": ">=24.0.0"},
  "overrides": {"undici": "7.30.1"},
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "0.28.2",
    "ical.js": "^2.2.1",
    "wrangler": "4.151.3"
  }
}
